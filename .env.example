# Copy to .env.local and fill in. .env.local is gitignored.

# --- Database -----------------------------------------------------------
# MongoDB Atlas connection string. Atlas is a replica set, so multi-document
# transactions are available to Better Auth.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Optional. Falls back to the database encoded in MONGODB_URI.
MONGODB_DB_NAME="dgclicks"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Must be the public origin users actually visit, with no trailing slash. This
# is not only the auth base URL: invite links and password-reset emails are
# built from it, and both get opened on someone else's machine. Left pointing at
# localhost in a deployment, every invite you send is a dead link.
# Preview deployments are handled automatically — the app trusts its own
# VERCEL_URL / VERCEL_BRANCH_URL hosts, so this stays on the production domain.
BETTER_AUTH_URL="http://localhost:3000"

# --- Transactional email -----------------------------------------------
# Optional together. Create an API key in Resend and use an address on a
# verified sending domain, e.g. "DG Clicks <security@example.com>".
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- AI workspace assistant --------------------------------------------
# Optional together. Keep the key server-only; choose a model that supports
# OpenRouter tool calling: https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# --- Access control -----------------------------------------------------
# Comma-separated email domains allowed to hold an account. LEAVE THIS EMPTY
# AND ANYONE WHO REACHES THE SIGN-UP PAGE CAN REGISTER. Set it to your company
# domain(s) before exposing this app.
#
# On a public URL this is the single most important variable here. Empty, it is
# not just open registration: a stranger can create their own workspace and
# spend your OpenRouter credits, and because the first account ever created
# becomes the administrator, whoever signs up before you do owns the install.
ALLOWED_EMAIL_DOMAINS=""
