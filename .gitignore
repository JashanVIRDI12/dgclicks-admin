# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Credential dumps from provider onboarding, e.g. atlas-credentials.env.
# `.env*` above only matches names that START with ".env", so this is not
# redundant — without it a downloaded secrets file lands in a commit.
*.env
!.env.example

# Cloud-sync duplicates. iCloud/Dropbox/OneDrive resolve a conflict by writing
# "page 2.tsx" beside "page.tsx". Inside .next they break `tsc` with duplicate
# type declarations; in src/ they are worse, because Next will happily route and
# build the copy.
*\ [0-9].*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
